# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:19006

# Audio Processing Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_DURATION=3
N_FFT=2048
HOP_LENGTH=512
N_MELS=128
FMAX=8000

# Model Configuration
# Path to your trained Keras model file
MODEL_PATH=C:\Users\SiluniR\Documents\final research\dataset\ESC-50\hazard_yamnet_finetuned_stage2.keras
# YAMNet model handle (TensorFlow Hub)
YAMNET_MODEL_HANDLE=https://tfhub.dev/google/yamnet/1
# Python executable path (use 'python' or 'python3' or full path)
PYTHON_EXECUTABLE=python
# Confidence threshold for model predictions (0.0 to 1.0)
MODEL_CONFIDENCE_THRESHOLD=0.3
# Audio sample rate (must match model training)
SAMPLE_RATE=16000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Hazard Priority Configuration
HAZARD_PRIORITIES={"fire_alarm":10,"car_horn":7,"glass_breaking":8,"dog_barking":5,"siren":9,"baby_crying":6,"smoke_alarm":10}



