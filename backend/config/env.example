# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:19006

# Audio Processing Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_DURATION=3
N_FFT=2048
HOP_LENGTH=512
N_MELS=128
FMAX=8000

# Model Configuration
# Path to your trained Keras model file (YAMNet-based Dense classifier)
MODEL_PATH=C:\Users\SiluniR\Documents\final research\dataset\yamnet_classifier_29_12_2025.keras
# Path to class labels file (optional, will use defaults if not found)
LABELS_PATH=C:\Users\SiluniR\Documents\final research\dataset\labels.npy
# YAMNet model handle (TensorFlow Hub)
YAMNET_MODEL_HANDLE=https://tfhub.dev/google/yamnet/1
# Python executable path (use 'python' or 'python3' or full path)
PYTHON_EXECUTABLE=python
# Confidence threshold for model predictions (0.0 to 1.0)
MODEL_CONFIDENCE_THRESHOLD=0.3
# Audio sample rate (must match model training)
SAMPLE_RATE=16000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Hazard Priority Configuration
# Priority scale: 10 = critical, 9 = very high, 8 = high, 7 = medium-high, 6 = medium, 5 = low
HAZARD_PRIORITIES={"fire_alarm":10,"smoke_alarm":10,"gun_shot":10,"fire":10,"siren":9,"alarm":9,"glass_breaking":8,"chainsaw":8,"fireworks":8,"car_horn":7,"baby_crying":6,"dog_barking":5}