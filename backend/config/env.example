# Server Configuration
PORT=
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:19006

# Audio Processing Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_DURATION=3
N_FFT=2048
HOP_LENGTH=512
N_MELS=128
FMAX=8000

# Model Configuration
# Model type: 'yamnet' or 'cnn14' (default: cnn14)
MODEL_TYPE=cnn14
# Path to your trained model file
# For CNN14: PyTorch model (.keras or .pth file)
# For YAMNet: Keras model (.keras or .h5 file)
MODEL_PATH=C:\Users\SiluniR\Documents\final research\dataset\cnn14_classifier_v3.keras
# Path to class labels file (optional, will use defaults if not found)
LABELS_PATH=C:\Users\SiluniR\Documents\final research\dataset\labels.npy
# YAMNet model handle (TensorFlow Hub) - only used if MODEL_TYPE=yamnet
YAMNET_MODEL_HANDLE=https://tfhub.dev/google/yamnet/1
# Python executable path (use 'python' or 'python3' or full path)
PYTHON_EXECUTABLE=python
# Confidence threshold for model predictions (0.0 to 1.0)
# This is the threshold for including multiple predictions in results
MODEL_CONFIDENCE_THRESHOLD=0.4
# Minimum confidence required for top prediction (0.0 to 1.0)
# If top prediction is below this, no detections will be returned (reduces false positives)
# Increased to 0.6 to reduce false positives (coughing/footsteps) from class imbalance
# Recommended: 0.6-0.7 for stricter filtering, 0.5-0.6 for balanced, 0.3-0.5 for more lenient
MODEL_MIN_CONFIDENCE=0.6
# Audio sample rate (must match model training: 32000 for CNN14, 16000 for YAMNet)
SAMPLE_RATE=32000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Hazard Priority Configuration
# Priority scale: 10 = critical, 9 = very high, 8 = high, 7 = medium-high, 6 = medium, 5 = low
HAZARD_PRIORITIES={"fire_alarm":10,"smoke_alarm":10,"gun_shot":10,"fire":10,"siren":9,"alarm":9,"glass_breaking":8,"chainsaw":8,"fireworks":8,"car_horn":7,"baby_crying":6,"dog_barking":5}

